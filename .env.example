# ─── Neon Postgres ──────────────────────────────────────────────────────────
# Added automatically when you connect Neon via the Vercel Storage integration.
# For local dev run: vercel env pull .env.local
DATABASE_URL=
# Direct (non-pooled) URL — used by drizzle-kit for schema pushes/migrations.
DATABASE_URL_UNPOOLED=

# ─── Clerk ──────────────────────────────────────────────────────────────────
# Create a Clerk app at https://clerk.com, then copy from API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect paths — must match the custom pages in src/app/sign-in and src/app/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ─── Scryfall ───────────────────────────────────────────────────────────────
# Optional — Scryfall etiquette requests a descriptive User-Agent.
SCRYFALL_USER_AGENT="stormcount/1.0 (contact: l.savinelli@gmail.com)"

# ─── Resend (contact / bug-report forms) ────────────────────────────────────
# Create a free account at https://resend.com, verify the sending domain,
# then copy your API key. The FROM address (src/lib/contactEmail.ts) is
# noreply@thecultist.it.
RESEND_API_KEY=re_...
# Email address that receives contact + bug-report submissions.
CONTACT_EMAIL=contact@stormcount.gg

# ─── Admin ───────────────────────────────────────────────────────────────────
# Admin access is the `users.is_admin` DB flag (see src/lib/auth/admin.ts):
#   UPDATE users SET is_admin = true WHERE id = 'user_...';

# ─── Cron ────────────────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/daily-seed.
# Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# ─── Affiliates (optional) ───────────────────────────────────────────────────
CAVERNHOLD_AFFILIATE_LINK=
TCG_PLAYER_PARTNER_LINK=
NEXT_PUBLIC_CARDTRADER_SHARE_CODE=
